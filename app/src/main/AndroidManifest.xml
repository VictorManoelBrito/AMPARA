<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AmparaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ampara" >
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ampara" />

        <!-- Modo disfarçado: apenas UM destes ícones fica ativo na tela inicial -->
        <activity-alias
            android:name=".ui.LauncherAmpara"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherDisfarce"
            android:enabled="false"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_edit"
            android:label="Bloco de Notas"
            android:roundIcon="@android:drawable/ic_menu_edit"
            android:targetActivity=".ui.NotasActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Bloqueio por PIN -->
        <activity android:name=".ui.BloqueioActivity"
            android:exported="false"
            android:label="@string/app_name" />
        <activity android:name=".ui.NotasActivity"
            android:exported="false"
            android:label="Bloco de Notas"
            android:theme="@style/Theme.Notas" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:label="Cadastro" />
        <activity android:name=".ui.MainActivity"
            android:exported="false"
            android:label="Ampara - Dashboard" />
        <activity android:name=".ui.QuizActivity"
            android:exported="false"
            android:label="Quiz" />
        <activity android:name=".ui.QuizSelectionActivity"
            android:exported="false"
            android:label="Temas do Quiz" />
        <activity android:name=".ui.DenunciaActivity"
            android:exported="false"
            android:label="Registrar Denúncia" />
        <activity android:name=".ui.RedeApoioActivity"
            android:exported="false"
            android:label="Rede de Apoio" />
        <activity android:name=".ui.MinhasDenunciasActivity"
            android:exported="false"
            android:label="Minhas Denúncias" />
        <activity android:name=".ui.LeisActivity"
            android:exported="false"
            android:label="Leis e Direitos" />
        <activity android:name=".ui.ConteudoActivity"
            android:exported="false"
            android:label="Conteúdo Educativo" />
        <activity android:name=".ui.DetalhesDenunciaActivity"
            android:exported="false"
            android:label="Detalhes da Denúncia" />
        <activity android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Configurações" />
        <activity android:name=".ui.AdminDashboardActivity"
            android:exported="false"
            android:label="Painel Administrativo" />
        <activity android:name=".ui.DetalhesInstituicaoActivity"
            android:exported="false"
            android:label="Detalhes da Instituição" />
        <activity android:name=".ui.LeituraActivity"
            android:exported="false"
            android:label="Leitura" />
        <activity android:name=".ui.QuizEducativoActivity"
            android:exported="false"
            android:label="Quiz" />
        <activity android:name=".ui.PerfilActivity"
            android:exported="false"
            android:label="Meu Perfil" />

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".util.AmparaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ampara_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@android:drawable/ic_dialog_info" />
    </application>

</manifest>