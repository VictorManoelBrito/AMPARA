<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Android 15 (API 35) ou superior: com targetSdk 35 o sistema força o modo
        "edge-to-edge" (a tela passa a ser desenhada por baixo da barra de status).
        Isso empurrava a barra de título para baixo da barra de status, e o toque
        na seta de voltar ia para o sistema. Esta opção mantém o comportamento
        anterior: a barra de status continua separada e com a cor do AMPARA.
    -->
    <style name="Theme.Ampara" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_ampara</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_ampara_light</item>
        <item name="android:statusBarColor">@color/primary_ampara</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="Theme.Notas" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#616161</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
