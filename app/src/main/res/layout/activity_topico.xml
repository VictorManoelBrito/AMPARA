<?xml version="1.0" encoding="utf-8"?>
<!-- Conteúdo educativo dividido em telas (uma por parte do tópico) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTopico"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/primary_ampara"
        app:title="Conteúdo educativo"
        app:titleTextColor="@color/primary_ampara" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressTopico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:indicatorColor="@color/primary_ampara"
        app:trackColor="@color/primary_ampara_light" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerTopico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnterior"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anterior"
            android:textColor="@color/primary_ampara" />

        <TextView
            android:id="@+id/tvPaginaTopico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1 de 1"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo"
            app:backgroundTint="@color/primary_ampara" />
    </LinearLayout>
</LinearLayout>
