<?xml version="1.0" encoding="utf-8"?>
<!-- Tela do modo disfarçado: um bloco de notas comum, sem nenhuma referência ao AMPARA. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical"
    tools:context=".ui.NotasActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarNotas"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:title="Bloco de Notas"
        app:titleTextColor="#212121" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/editNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF9C4"
                android:gravity="top|start"
                android:hint="Escreva sua nota..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="6"
                android:padding="16dp"
                android:textColor="#212121"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSalvarNota"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#616161"
                android:text="Salvar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvTituloNotas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Minhas notas"
                android:textColor="#616161"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/listaNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
